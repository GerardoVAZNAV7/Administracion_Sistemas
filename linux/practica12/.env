# ============================================================
#  .env — Práctica 12 · Servidor de Correo Privado
#  NO subir a repositorios públicos
# ============================================================

# ── Dominio e identidad ───────────────────────────────────────
MAIL_DOMAIN=reprobados.com
MAIL_HOSTNAME=mail.reprobados.com

# ── Credenciales de cuentas de correo ────────────────────────
# Formato: usuario@dominio|contraseña  (se crean al iniciar)
MAIL_USER1=director@reprobados.com
MAIL_PASS1=Director2025!
MAIL_USER2=admin@reprobados.com
MAIL_PASS2=Admin2025!

# ── Postmaster ───────────────────────────────────────────────
POSTMASTER_ADDRESS=admin@reprobados.com

# ── SSL/TLS (certificados autofirmados generados por setup.sh) ─
SSL_TYPE=self-signed

# ── Fail2Ban ─────────────────────────────────────────────────
FAIL2BAN_ENABLED=1
FAIL2BAN_MAX_RETRY=5
FAIL2BAN_BANTIME=3600

# ── Rspamd ────────────────────────────────────────────────────
RSPAMD_ENABLED=1

# ── Puertos expuestos (coexistencia con práctica 11) ─────────
# SMTP
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587
SMTP_SUBMISSIONS_PORT=465
# IMAP
IMAP_PORT=143
IMAPS_PORT=993
# Roundcube (evita conflicto con nginx de práctica 11 en :80)
ROUNDCUBE_PORT=8080
ROUNDCUBE_SSL_PORT=8443

# ── MariaDB para Roundcube ────────────────────────────────────
ROUNDCUBE_DB_NAME=roundcubemail
ROUNDCUBE_DB_USER=roundcube
ROUNDCUBE_DB_PASSWORD=Roundcube2025!
ROUNDCUBE_DB_ROOT_PASSWORD=RootRound2025!

# ── Seguridad de sesión Roundcube ────────────────────────────
ROUNDCUBE_DES_KEY=reprobados2025xSecretKey123456
ROUNDCUBE_SESSION_TIMEOUT=30
